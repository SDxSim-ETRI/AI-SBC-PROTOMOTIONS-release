# render_look.env — 릴리즈 추론시각화 렌더 룩의 **단일 진실 원천**
#
# 왜 이 파일이 있나 (2026-08-28)
# ------------------------------
# 룩이 스크립트 기본값에 의존하면 조용히 바뀐다. 실제로 두 번 일어났다:
#   · 2026-08-07 팔레트 기본값을 Newton 렌더에 맞춰 변경 → 과거 영상 재현 불가
#     (INFO.md §7 "이 영상은 인자를 특정하지 못했다")
#   · 2026-08-27 신설한 scripts/retrain/train_stage_lib.sh 의 render_videos() 가
#     룩 지정을 누락 → 기본값 flat(살색 displayColor)+밝은 조명으로 렌더됨
# 값 자체는 5개 스크립트(make_s1_360_videos / orchestrate_after_training /
# make_cmu38_04_videos / finish_videos_and_rename / regen_s1_videos)에 동일하게
# 복사돼 있었다. 복사본이 아니라 **이 파일 하나**를 참조하도록 모은다.
#
# 핵심 원칙: 여기서 **관련 변수를 전부 명시 지정**한다. 그래야 렌더 스크립트의
#           기본값이 나중에 바뀌어도 산출물이 변하지 않는다.
#
# 사용:
#   source /home/user/PM_Tasks/tasks_for_smpl/script/render_look.env
#   "$ISAACSIM" tasks_for_smpl/script/render_exosuit_isaacsim.py hs eval out.mp4 300 roll.motion
#
# 룩을 바꾸려면 이 파일만 고치고, 바꾼 이유와 날짜를 아래 이력에 남길 것.
# ============================================================================

# ── 인체 스킨 재질: 갈색 무광 고무 ──────────────────────────────────────────
# skin_rubber 프리셋이 아래 rgb/rough/cc 와 같은 값을 갖지만, 프리셋이 바뀌어도
# 산출물이 불변하도록 MAT_* 를 명시 지정한다(원칙: 기본값에 의존하지 않는다).
export SKIN_MAT=skin_rubber
export MAT_RGB="0.70,0.50,0.40"   # 갈색 (0.85,0.68,0.55 살색보다 어둡고 채도 높음)
export MAT_ROUGH=0.75             # 무광 — PBR 고무 권장치 ~0.7
export MAT_CLEARCOAT=0.0          # 광택층 없음 (rubber 프리셋의 0.35 는 광택이 생긴다)
export MAT_CC_ROUGH=0.30          # clearcoat 0 이면 무효지만 명시해 둔다
export SMOOTH=1                   # 정점 노멀 사용. 0 이면 삼각형 줄무늬가 보인다

# ── 조명·바닥 ───────────────────────────────────────────────────────────────
# ★ 스크립트 기본값(SKY 500 / KEY 3200)은 살색 스킨을 흰색으로 클리핑시켜
#   재질 차이가 화면에 안 나타난다. 무광을 보이게 하려면 반드시 낮춰야 한다.
export SKY_INTENSITY=380
export KEY_INTENSITY=1300
export KEY_ROT="-42,0,215"
export FLOOR_A=0.30               # 밝은 타일 / 어두운 타일 반사율
export FLOOR_B=0.24

# ── 경로 ────────────────────────────────────────────────────────────────────
export PM_CODE_ROOT="${PM_CODE_ROOT:-/home/user/ProtoMotions_etri}"
export PM_TASKS_ROOT="${PM_TASKS_ROOT:-/home/user/PM_Tasks}"
export PYTHONPATH="${PM_TASKS_ROOT}:${PYTHONPATH:-}"

# 카메라(CAM/CAM_R)와 HUD 는 용도마다 다르므로 여기서 고정하지 않는다.
#   360° 데모: CAM=turntable CAM_R=3.5   정면 데모: CAM=front CAM_R=5.0
#   평가 영상: CAM=side CAM_R=3.5 (2026-08-28 4.5→3.5 로 근접. 검증된 촬영거리 재사용)
#   36모션 평가 영상: CAM=front_rel CAM_R=4.0  (2026-08-31 신설)
#     · front_rel 인 이유: 월드고정 side/front 는 모션마다 진행방향이 달라 앵글이 제각각이다.
#       36모션처럼 방향이 섞인 집합에서는 진행방향 기준 상대 카메라라야 앵글이 일정하다.
#     · CAM_R 이 3.5 가 아닌 이유: front_rel 은 인물이 화면 중앙·상단을 채워
#       **좌상단 HUD 텍스트와 겹친다**(side 에서는 겹치지 않아 드러나지 않던 문제).
#       4.0 으로 물려 인물을 작게 만들어 회피한다. 사용자 확인 후 채택.
#   호출측에서 지정할 것.

# ── 선정 근거 ───────────────────────────────────────────────────────────────
# 2026-08-11  여러 색상과 유광/무광 후보를 실제로 렌더해 나란히 비교한 뒤 사용자가 선택.
#             **이 조합(갈색 0.70,0.50,0.40 + roughness 0.75 + clearcoat 0)이 인체에
#             가장 가깝게 보인다**는 것이 채택 사유다. 수치를 이론적으로 유도한 것이
#             아니라 눈으로 비교해 고른 값이므로, 임의로 근사값을 새로 만들지 말 것 —
#             재생성하면 같은 룩이 나오지 않는다(사용자 확인, 2026-08-28).
#             배경(하늘 돔)·바닥·조명도 이 조합에서 피부색이 자연스럽게 보이도록 함께
#             맞춘 값이다. 재질만 떼어 쓰면 안 되고 세트로 유지한다.
#             기준 산출물: recordings/2026-08-25-16-14-00-exosuitHS_rubber_flat_turntable/
#                          demo_exosuitHS_rubber_flat.mp4
#
# ── 이력 ────────────────────────────────────────────────────────────────────
# 2026-08-28  파일 신설. 값은 기존 5개 스크립트의 공통값을 그대로 승격(변경 없음).
#             SKIN_MAT 을 rubber(+MAT_RGB 오버라이드) → skin_rubber 프리셋으로 교체.
#             (원 근거 문서였던 mjcf_skin/INFO.md §3 은 2026-08-27 문서 개편 때 소실 —
#              값은 실행 명령에만 남아 있었다. 근거를 여기에 복원해 둔다.)
